{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsta-web",
  "account_id": "fa182a4b7bf993c163f7e80571f6ad93",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_DATA"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_STATE",
        "class_name": "DashboardChatQueue"
      }
    ]
  },
  "exports": {
    "DashboardChatQueue": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
