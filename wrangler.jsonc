{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsta-web",
  "account_id": "fa182a4b7bf993c163f7e80571f6ad93",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Corte multiusuario 14-10-2026: cuentas por usuario (D66) sobre el mismo KV y Durable Object.
  "vars": {
    "AUTH_MODE": "accounts"
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_DATA",
      "id": "8ae3f32a6d844bb8a42adaa3b046bd7e"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsta-web-accounts",
      "database_id": "ccc417d3-1289-44ca-9d72-6bdb370d0d91",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_STATE",
        "class_name": "DashboardChatQueue"
      }
    ]
  },
  "exports": {
    "DashboardChatQueue": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
