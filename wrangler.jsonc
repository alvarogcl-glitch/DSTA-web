{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsta-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_DATA"
    }
  ],
  "observability": {
    "enabled": true
  }
}
