{
  // STAGING del DSTA multiusuario: Worker, D1 y Durable Objects propios; solo datos sintéticos.
  // Nunca usar esta config con datos reales ni contra dsta-web (producción usa wrangler.jsonc).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsta-web-staging",
  "account_id": "fa182a4b7bf993c163f7e80571f6ad93",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "AUTH_MODE": "accounts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsta-web-staging-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_STATE",
        "class_name": "DashboardChatQueue"
      }
    ]
  },
  "exports": {
    "DashboardChatQueue": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
